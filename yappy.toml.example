# Yappy TTS Server Configuration
# Copy to yappy.toml and customize as needed

[server]
host = "127.0.0.1"
port = 3000
log_level = "info"
idle_timeout_secs = 300      # 5 minutes
synthesis_timeout_secs = 30

[buffer]
flush_timeout_ms = 500
max_size_bytes = 4096

[providers]
# Default provider used when client doesn't specify one
default = "kokoro"

# Kokoro 82M ONNX - Local model (default provider)
[providers.kokoro]
model_path = "auto"          # Downloads from HuggingFace on first use
voices_path = "auto"
# Or specify explicit paths:
# model_path = "/path/to/kokoro-v1.0.onnx"
# voices_path = "/path/to/voices-v1.0.bin"

# OpenAI TTS - Cloud-based (requires API key)
[providers.openai]
api_key = "$OPENAI_API_KEY"  # Environment variable reference
model = "tts-1"              # or "tts-1-hd" for higher quality

# AVSpeechSynthesizer - macOS built-in (automatically enabled on macOS)
[providers.avspeech]
enabled = true
